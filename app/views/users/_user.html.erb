<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <p>
     <strong>Photo:</strong>
        <% if user.photo.attached? %>
        <!-- リサイズ後の画像（サムネイル）を表示 -->
        <%= image_tag user.thumbnail %>
        <!-- 元の画像を表示 -->
        <%= image_tag user.photo %>
     <% end %>
  </p>

</div>
